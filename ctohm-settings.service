[Unit]
Description=ConnectOhm Settings Daemon
# BindsTo means if the /dev/ctohm0 node disappears (unplugged), systemd will immediately stop this service automatically.
# As far as WHAT to bind to, I have absolutely ZERO idea what everything after the = means. It's code Gemini created, so USE AT YOUR OWN RISK. It works, and it seems harmless enough to me.
# NOTE: Palm OS does make 2 devices, and the 2nd one is usually the one we want to communicate on. However, since most devices only create 1, binding to the 1st one is good enough. 
BindsTo=dev-ctohm0.device
After=dev-ctohm0.device

[Service]
Type=simple
# Launch our verified configuration
ExecStart=/usr/local/bin/ctohm-settings.sh
# Clean up after disconnect
Restart=no

[Install]
WantedBy=multi-user.target
