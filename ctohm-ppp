/dev/ctohm0
115200

# Tell the Pi its interface IP is 192.168.2.1
192.168.2.1:

# The magic ticket: tells pppd to look in the secrets file 
# to assign a dynamic IP to the client
auth
require-pap

local
lock

# Testing: we're terminating on signal 2, which I think means we HAVE to detach. And if this fixes THAT issue, try having those 1st two lines passed from ctohm-settings.sh
# nodetach

nocrtscts
passive
silent
persist

# Pass DNS directly through the handshake
ms-dns 1.1.1.1
ms-dns 8.8.8.8

logfile /var/log/ctohm-ppp.log
