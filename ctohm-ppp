# System occasionally juggles 2 ports from Palm OS, so we have to run pppd on both. Therefore, we can't specify these in the peer file
# /dev/ctohm0
# /dev/ttyUSB1
# 115200

# Tell the Pi its interface IP is 192.168.2.1
192.168.2.1:

# The magic ticket: tells pppd to look in the secrets file 
# to assign a dynamic IP to the client
auth
require-pap

local
lock
nodetach
nocrtscts
passive
silent
persist

# Pass DNS directly through the handshake
ms-dns 1.1.1.1
ms-dns 8.8.8.8
